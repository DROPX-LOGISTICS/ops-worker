# Copy this file to .dev.vars for local `wrangler dev` / `npm run dev`.
# .dev.vars is gitignored — never commit real secrets.

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Shared secret for /api/admin/* (header: x-admin-key). Generate with:
#   openssl rand -hex 32
ADMIN_API_KEY="change-me-to-a-long-random-string"

# Amazon Logistics portal login (used by scripts/local-session-login.mjs and
# Cloudflare Browser Rendering auto-refresh). Prefer storing these via
# PUT /api/admin/credentials after first deploy so they can be rotated without redeploy.
AMAZON_PORTAL_EMAIL="portal-user@example.com"
AMAZON_PORTAL_PASSWORD="your-portal-password"

# Station used only to open the cash overview page during login capture
# for the *default* portal account. Validate requests still send their own stationCode.
AMAZON_LOGIN_STATION_CODE="TIRC"

# Dedicated stations (KDJG, JUGF, AWEZ, KGQE, HBSC) use separate portal accounts.
# 1) Run sql/migrate-multi-portal-accounts.sql in Supabase
# 2) npm run credentials:seed-stations
# 3) Ensure/refresh session with { "stationCode": "HBSC" } (etc.)
#
# HBSC credentials (required — cannot use default portal user):
HBSC_PORTAL_EMAIL="hbsc-user@amazon.com"
HBSC_PORTAL_PASSWORD="your-hbsc-password"
# Aliases also accepted: HBSC_ID / HBSC_PASS

# Workforce portal (logistics.amazon.in) — Puppeteer auto-login.
# Flow: /performance → (optional soft captcha) → email → Continue → password → Sign in
WORKFORCE_PORTAL_EMAIL="workforce-user@example.com"
WORKFORCE_PORTAL_PASSWORD="your-workforce-password"
# WORKFORCE_BASE_URL="https://logistics.amazon.in"
# WORKFORCE_COMPANY_ID="b63603e9-36e2-4656-9b87-c421489a64a9"

# Where session:login / workforce:login POST cookies.
# Local default is http://127.0.0.1:8787 — start `npm run dev` first.
# WORKER_URL="https://your-worker.workers.dev"

# Who receives AMAZON_LOGIN_FAILED / AMAZON_SESSION_EXPIRED notifications.
OWNER_EMAIL="owner@yourcompany.com"

# Optional — email alerts in addition to owner_notifications rows.
# RESEND_API_KEY="re_xxx"
# OWNER_NOTIFICATION_EMAIL="owner@yourcompany.com"
# NOTIFICATION_FROM_EMAIL="ops-alerts@yourdomain.com"
