{
  "name": "cash-recon-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that validates a station's cash denomination submission against pending driver reconciliation, remittance totals, and station liability before allowing it to proceed, with a Supabase-backed manual override trail.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "wrangler dev -c wrangler.dev.toml",
    "dev:remote": "wrangler dev --remote",
    "session:login": "node scripts/local-session-login.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "hono": "^4.6.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "puppeteer": "^24.43.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.116.0"
  }
}
